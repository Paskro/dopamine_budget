<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/widget_canvas_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@android:color/transparent" />

    <!-- 6 invisible tap buttons, shown/hidden dynamically -->
    <ImageButton
        android:id="@+id/habit_btn_0"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:src="@null"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/habit_btn_1"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:src="@null"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/habit_btn_2"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:src="@null"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/habit_btn_3"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:src="@null"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/habit_btn_4"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:src="@null"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/habit_btn_5"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:src="@null"
        android:visibility="gone" />

</FrameLayout>
